(fn Escrow_HarnessScenario ()
  (bind _now (Utilities|Time|GetGameTimeInSeconds))
  (bind _scen (Variables|Default|GetScenarioId))
  (bind _stage (Variables|Default|GetScenarioStage))
  (bind _followers (Actor|GetAllActorsOfClass "/Game/ESCROW/Blueprints/Followers/BP_ESCROW_FollowerVehicle.BP_ESCROW_FollowerVehicle_C"))
  (if (== _scen 1)
    (if (== _stage 0)
      (for _f _followers
        (bind _id (Class|BPESCROWFollowerVehicle|GetFollowerID _f))
        (bind _root (Class|WheeledVehiclePawn|GetMesh _f))
        (if (== _id 1)
          (Transformation|SetActorLocationAndRotation :self _f :NewLocation (Math|Vector|MakeVector 4391.0 -9428.0 -6920.0) :NewRotation (Math|Rotator|MakeRotator 0.0 0.0 143.5) :bSweep false :bTeleport true)
          (Physics|SetPhysicsLinearVelocity _root (Math|Vector|MakeVector 0.0 0.0 0.0))
          (Physics|SetPhysicsAngularVelocityinDegrees _root (Math|Vector|MakeVector 0.0 0.0 0.0)))
        (if (== _id 2)
          (Transformation|SetActorLocationAndRotation :self _f :NewLocation (Math|Vector|MakeVector 5745.0 -11180.0 -7025.0) :NewRotation (Math|Rotator|MakeRotator 0.0 0.0 74.5) :bSweep false :bTeleport true)
          (Physics|SetPhysicsLinearVelocity _root (Math|Vector|MakeVector 0.0 0.0 0.0))
          (Physics|SetPhysicsAngularVelocityinDegrees _root (Math|Vector|MakeVector 0.0 0.0 0.0))))
      (if (> _now 7.0)
        (Variables|Default|SetNextOrderTime (+ _now 4.0))
        (Variables|Default|SetScenarioStage 1)))
    (if (and (== _stage 1) (> _now (Variables|Default|GetNextOrderTime)))
      (Class|BPESCROWConvoyTelemetryManager|EscrowApplyNavOrder :self (Variables|Default|GetConvoyMgr) :FollowerID 2 :OrderType 1 :TargetVehicleID 1 :TargetLocation "0, 0, 0" :BreadcrumbIndex 0 :Reason "TestHarness")
      (Variables|Default|SetRouteDoneTime _now)
      (Variables|Default|SetScenarioStage 2)
      (Development|PrintString "HARNESS scenario order issued" false))
    (if (and (== _stage 2) (> _now (+ (Variables|Default|GetRouteDoneTime) 50.0)))
      (Variables|Default|SetScenarioStage 3)
      (Development|PrintString "HARNESS DONE" false)))
  (if (== _scen 2)
    (if (and (== _stage 0) (> _now 8.0))
      (for _f _followers
        (if (== (Class|BPESCROWFollowerVehicle|GetFollowerID _f) 3)
          (Class|BPESCROWFollowerVehicle|EscrowEscalatetoOperator _f)))
      (Variables|Default|SetRouteDoneTime _now)
      (Variables|Default|SetScenarioStage 1)
      (Development|PrintString "HARNESS forced escalation" false))
    (if (and (== _stage 1) (> _now (+ (Variables|Default|GetRouteDoneTime) 6.0)))
      (Variables|Default|SetScenarioStage 2)
      (Development|PrintString "HARNESS DONE" false)))
  (if (== _scen 3)
    (CallFunction|EscrowHarnessScenarioRock))
  (if (== _scen 4)
    (CallFunction|EscrowHarnessScenarioRecovery))
  (if (== _scen 5)
    (CallFunction|EscrowHarnessScenarioFlat)))
