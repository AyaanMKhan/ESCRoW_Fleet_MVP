(fn Escrow_HarnessSetLeg (X Y)
  (bind _goal (Math|Vector|MakeVector X Y 120.0))
  (bind _cv (Variables|Default|GetCmdVehicle))
  (bind _path (AI|Navigation|FindPathToLocationSynchronously (Transformation|GetActorLocation _cv) _goal _cv))
  (bind _pts (Class|NavigationPath|GetPathPoints _path))
  (bind _n (Utilities|Array|Length _pts))
  (Utilities|Array|Clear (Variables|Default|GetRoute))
  (for _i (range _n)
    (if (> _i 0)
      (Utilities|Array|Add (Variables|Default|GetRoute) (Utilities|Array|Get(acopy) _pts _i))))
  (if (or (< _n 2) (AI|Navigation|IsPartial _path))
    (Development|PrintString (Utilities|String|Append "HARNESS leg nav path missing or partial, points " (Utilities|String|ToString(Integer) _n)) false)
    (Utilities|Array|Add (Variables|Default|GetRoute) _goal)
    (else
      (Development|PrintString (Utilities|String|Append "HARNESS leg nav points " (Utilities|String|ToString(Integer) _n)) false)))
  (Variables|Default|SetRouteIdx 0)
  (Variables|Default|SetRouteDone false))
