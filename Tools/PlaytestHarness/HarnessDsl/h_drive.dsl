(fn Escrow_HarnessDrive ()
  (bind _now (Utilities|Time|GetGameTimeInSeconds))
  (bind _cv (Variables|Default|GetCmdVehicle))
  (bind _vmc (Class|WheeledVehiclePawn|GetVehicleMovementComponent _cv))
  (bind _idx (Variables|Default|GetRouteIdx))
  (if (>= _idx (Utilities|Array|Length (Variables|Default|GetRoute)))
    (Game|Components|ChaosVehicleMovement|SetThrottleInput _vmc 0.0)
    (Game|Components|ChaosVehicleMovement|SetBrakeInput _vmc 1.0)
    (if (not (Variables|Default|GetRouteDone))
      (Variables|Default|SetRouteDone true)
      (Variables|Default|SetRouteDoneTime _now)
      (Development|PrintString "HARNESS route complete" false))
    (if (and (== (Variables|Default|GetScenarioId) 0) (and (> (- _now (Variables|Default|GetRouteDoneTime)) 40.0) (not (Variables|Default|GetDoneLogged))))
      (Variables|Default|SetDoneLogged true)
      (Development|PrintString "HARNESS DONE" false))
    (else
      (bind _loc (Transformation|GetActorLocation _cv))
      (bind _fwd (Transformation|GetActorForwardVector _cv))
      (bind _right (Transformation|GetActorRightVector _cv))
      (bind _wp (Utilities|Array|Get(acopy) (Variables|Default|GetRoute) _idx))
      (bind _to (- _wp _loc))
      (bind _speed (Math|Vector|DotProduct (Transformation|GetVelocity _cv) _fwd))
      (bind _err (Math|Trig|Atan2(Degrees) (Math|Vector|DotProduct _to _right) (Math|Vector|DotProduct _to _fwd)))
      (Game|Components|ChaosVehicleMovement|SetSteeringInput _vmc (Math|Float|Clamp(Float) (/ _err 35.0) -1.0 1.0))
      (bind _tgt (* (Variables|Default|GetCruise) (Math|Float|Clamp(Float) (- 1.0 (/ (* _err _err) 3600.0)) 0.35 1.0)))
      (Game|Components|ChaosVehicleMovement|SetThrottleInput _vmc (Math|Float|Clamp(Float) (/ (- _tgt _speed) 300.0) 0.0 1.0))
      (Game|Components|ChaosVehicleMovement|SetBrakeInput _vmc (Math|Float|Clamp(Float) (/ (- _speed _tgt) 400.0) 0.0 1.0))
      (if (< (Math|Vector|Distance2D(Vector) _loc _wp) 800.0)
        (Variables|Default|SetRouteIdx (+ _idx 1))
        (Development|PrintString (Utilities|String|Append "HARNESS waypoint " (Utilities|String|ToString(Integer) _idx)) false)))))
