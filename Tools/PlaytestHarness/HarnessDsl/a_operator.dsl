(fn Escrow_EscalateToOperator ()
  (if (not (Variables|Default|GetAutonomyDegraded))
    (Variables|Default|SetAutonomyDegraded true)
    (Variables|Default|SetReversing false)
    (Variables|Default|SetBlockedTime 0.0)
    (Variables|Default|SetStuckTimer 0.0)
    (bind _vmc (Variables|Vehicle|GetVehicleMovementComponent))
    (Game|Components|ChaosVehicleMovement|SetUseAutomaticGears _vmc true)
    (Game|Components|ChaosVehicleMovement|SetTargetGear _vmc 1 true)
    (bind _fleet (ESCRoW|Subsystems|GetESCROWFleetSubsystem))
    (bind _id (Variables|Default|GetFollowerID))
    (bind (_status _found) (ESCRoW|Fleet|GetFollowerStatus :self _fleet :FollowerID _id))
    (bind (_s0 _s1 _s2 _s3 _s4 _s5 _s6 _s7 _s8 _s9 _s10 _s11 _s12 _s13 _s14 _s15 _s16) (Utilities|Struct|BreakESCROWFollowerStatus _status))
    (Variables|Default|SetRecoverySavedObjective _s4)
    (ESCRoW|Fleet|SetFollowerObjective :self _fleet :FollowerID _id :ObjectiveText "Requesting assistance")
    (ESCRoW|Fleet|SetAutonomyMode :self _fleet :FollowerID _id :NewMode "Degraded")
    (ESCRoW|Fleet|SetRequiresTakeover :self _fleet :FollowerID _id :bRequiresTakeover true)
    (Development|PrintString (Utilities|String|Append "AUTONOMY ESCALATED F" (Utilities|String|ToString(Integer) _id)) false)
    (CallFunction|EscrowLogAutonomyEvent :EventType "Escalated" :Detail "Unscripted help request: recovery attempts exhausted; holding, shown on the follower page only")))
