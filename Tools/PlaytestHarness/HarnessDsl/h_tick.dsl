(fn Escrow_HarnessTick ()
  (bind _now (Utilities|Time|GetGameTimeInSeconds))
  (if (not (Variables|Default|GetControlTaken))
    (if (> _now 2.0)
      (CallFunction|EscrowHarnessTakeControl))
    (elif (> (Variables|Default|GetScenarioId) 0)
      (CallFunction|EscrowHarnessScenario)
      (else
      (bind _issued (Variables|Default|GetOrdersIssued))
      (if (and (< _issued 4) (> _now (Variables|Default|GetNextOrderTime)))
        (Class|BPESCROWConvoyTelemetryManager|EscrowApplyNavOrder :self (Variables|Default|GetConvoyMgr) :FollowerID (+ _issued 1) :OrderType 1 :TargetVehicleID _issued :TargetLocation "0, 0, 0" :BreadcrumbIndex 0 :Reason "TestHarness")
        (Variables|Default|SetOrdersIssued (+ _issued 1))
        (Variables|Default|SetNextOrderTime (+ _now 2.0))
        (Development|PrintString "HARNESS order issued" false))
      (if (> _now 16.0)
        (CallFunction|EscrowHarnessDrive))))))
