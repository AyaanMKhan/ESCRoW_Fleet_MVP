(fn Escrow_HarnessScenarioRock ()
  (bind _now (Utilities|Time|GetGameTimeInSeconds))
  (bind _stage (Variables|Default|GetScenarioStage))
  (if (and (== _stage 0) (> _now 6.0))
    (Class|BPESCROWConvoyTelemetryManager|EscrowApplyNavOrder :self (Variables|Default|GetConvoyMgr) :FollowerID 2 :OrderType 4 :TargetVehicleID 0 :TargetLocation (Math|Vector|MakeVector 10500.0 -12000.0 -6960.0) :BreadcrumbIndex 0 :Reason "TestHarness")
    (Variables|Default|SetNextOrderTime (+ _now 4.0))
    (Variables|Default|SetScenarioStage 1)
    (Development|PrintString "HARNESS rock order F2" false))
  (if (and (== _stage 1) (> _now (Variables|Default|GetNextOrderTime)))
    (Class|BPESCROWConvoyTelemetryManager|EscrowApplyNavOrder :self (Variables|Default|GetConvoyMgr) :FollowerID 3 :OrderType 4 :TargetVehicleID 0 :TargetLocation (Math|Vector|MakeVector 10500.0 -12400.0 -6960.0) :BreadcrumbIndex 0 :Reason "TestHarness")
    (Variables|Default|SetNextOrderTime (+ _now 4.0))
    (Variables|Default|SetScenarioStage 2)
    (Development|PrintString "HARNESS rock order F3" false))
  (if (and (== _stage 2) (> _now (Variables|Default|GetNextOrderTime)))
    (Class|BPESCROWConvoyTelemetryManager|EscrowApplyNavOrder :self (Variables|Default|GetConvoyMgr) :FollowerID 4 :OrderType 4 :TargetVehicleID 0 :TargetLocation (Math|Vector|MakeVector 10500.0 -11300.0 -6960.0) :BreadcrumbIndex 0 :Reason "TestHarness")
    (Variables|Default|SetRouteDoneTime _now)
    (Variables|Default|SetScenarioStage 3)
    (Development|PrintString "HARNESS rock order F4" false))
  (if (and (== _stage 3) (> _now (+ (Variables|Default|GetRouteDoneTime) 100.0)))
    (Variables|Default|SetScenarioStage 4)
    (Development|PrintString "HARNESS DONE" false)))
