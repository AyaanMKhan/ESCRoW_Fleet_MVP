(fn Escrow_HarnessCheckFaults ()
  (bind _now (Utilities|Time|GetGameTimeInSeconds))
  (bind _fleet (ESCRoW|Subsystems|GetESCROWFleetSubsystem))
  (bind _active (Variables|Default|GetActiveFault))
  (if (== _active 0)
    (for _f (Actor|GetAllActorsOfClass "/Game/ESCROW/Blueprints/Followers/BP_ESCROW_FollowerVehicle.BP_ESCROW_FollowerVehicle_C")
      (bind _id (Class|BPESCROWFollowerVehicle|GetFollowerID _f))
      (bind _done (or (and (== _id 2) (Variables|Default|GetFaultDone2)) (and (== _id 4) (Variables|Default|GetFaultDone4))))
      (if (and (or (== _id 2) (== _id 4)) (not _done))
        (bind (_st _ok) (ESCRoW|Fleet|GetFollowerStatus :self _fleet :FollowerID _id))
        (bind (_s0 _s1 _s2 _s3 _s4 _s5 _s6 _s7 _s8 _s9 _s10 _s11 _s12 _s13 _s14 _s15 _s16) (Utilities|Struct|BreakESCROWFollowerStatus _st))
        (if (and _s9 (Variables|Default|GetCanTakeFault))
          (Variables|Default|SetActiveFault _id)
          (Variables|Default|SetFaultVehicle _f)
          (Variables|Default|SetFaultStage 0)
          (Variables|Default|SetFaultTime _now)
          (ESCRoW|Fleet|AcquireTakeoverLock :self _fleet :FollowerID _id)
          (Development|PrintString (Utilities|String|Append "HARNESS takeover F" (Utilities|String|ToString(Integer) _id)) false))))
    (else
      (bind _stage (Variables|Default|GetFaultStage))
      (if (and (== _stage 0) (> (- _now (Variables|Default|GetFaultTime)) 3.0))
        (bind _rs (Actor|GetAllActorswithTag "ESCROW_RallyMarker_R"))
        (if (> (Utilities|Array|Length _rs) 0)
          (bind _loc (Transformation|GetActorLocation (Utilities|Array|Get(acopy) _rs)))
          (Variables|Default|SetFaultTarget _loc)
          (Class|BPESCROWConvoyTelemetryManager|EscrowApplyNavOrder :self (Variables|Default|GetConvoyMgr) :FollowerID _active :OrderType 4 :TargetVehicleID 0 :TargetLocation _loc :BreadcrumbIndex 0 :Reason "TestHarness")
          (Variables|Default|SetFaultStage 1)
          (Development|PrintString (Utilities|String|Append "HARNESS driving to recovery " (Utilities|String|ToString(Vector) _loc)) false)))
      (if (and (== _stage 1) (< (Math|Vector|Distance2D(Vector) (Transformation|GetActorLocation (Variables|Default|GetFaultVehicle)) (Variables|Default|GetFaultTarget)) 2000.0))
        (Variables|Default|SetFaultTime _now)
        (Variables|Default|SetFaultStage 2))
      (if (and (== _stage 2) (> (- _now (Variables|Default|GetFaultTime)) 2.0))
        (ESCRoW|Fleet|ReleaseTakeoverLock :self _fleet :FollowerID _active)
        (if (== _active 2)
          (Variables|Default|SetFaultDone2 true))
        (if (== _active 4)
          (Variables|Default|SetFaultDone4 true))
        (Variables|Default|SetActiveFault 0)
        (Development|PrintString "HARNESS takeover released" false)))))
