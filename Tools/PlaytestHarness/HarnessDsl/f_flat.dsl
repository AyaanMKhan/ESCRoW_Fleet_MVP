(fn Escrow_HarnessScenarioFlat ()
  (bind _now (Utilities|Time|GetGameTimeInSeconds))
  (bind _s (Variables|Default|GetScenarioStage))
  (bind _since (- _now (Variables|Default|GetRouteDoneTime2)))
  (bind _phase (ESCRoW|Tasking|GetCurrentPhaseName (ESCRoW|Subsystems|GetESCROWScenarioDirectorSubsystem)))
  (if (> (- _now (Variables|Default|GetLastHarnessLog)) 15.0)
    (Variables|Default|SetLastHarnessLog _now)
    (Development|PrintString (Utilities|String|Append (Utilities|String|Append "HARNESS stage " (Utilities|String|ToString(Integer) _s)) (Utilities|String|Append " phase " _phase)) false))
  (CallFunction|EscrowHarnessCheckFaults)
  (if (and (>= _s 1) (Variables|Default|GetDriveOn))
    (CallFunction|EscrowHarnessDrive))
  (if (and (== _s 0) (> _now 4.0))
    (Variables|Default|SetCruise 1500.0)
    (CallFunction|EscrowHarnessWaypoint :Id 1 :X -3000.0 :Y 42000.0)
    (CallFunction|EscrowHarnessWaypoint :Id 2 :X 4000.0 :Y 42000.0)
    (CallFunction|EscrowHarnessWaypoint :Id 3 :X -3000.0 :Y 47000.0)
    (CallFunction|EscrowHarnessWaypoint :Id 4 :X 4000.0 :Y 47000.0)
    (CallFunction|EscrowHarnessSetLeg :X 670.0 :Y 44300.0)
    (Variables|Default|SetDriveOn true)
    (Variables|Default|SetRouteDoneTime2 _now)
    (Variables|Default|SetScenarioStage 1))
  (if (and (== _s 1) (Variables|Default|GetRouteDone))
    (CallFunction|EscrowHarnessGatherCount)
    (if (and (== (Variables|Default|GetGatherCount) 4) (> _since 5.0))
      (bind _ok (CallFunction|EscrowHarnessAck :Sub "CONFIRM-GATHER"))
      (if _ok
        (Variables|Default|SetRouteDoneTime2 _now)
        (Variables|Default|SetScenarioStage 2))))
  (if (and (== _s 2) (> _since 12.0))
    (CallFunction|EscrowHarnessChain)
    (Variables|Default|SetRouteDoneTime2 _now)
    (Variables|Default|SetScenarioStage 3))
  (if (and (== _s 3) (> _since 4.0))
    (CallFunction|EscrowHarnessSetLeg :X 670.0 :Y 194300.0)
    (Variables|Default|SetCanTakeFault true)
    (Variables|Default|SetScenarioStage 4))
  (if (and (== _s 4) (and (Variables|Default|GetRouteDone) (Variables|Default|GetFaultDone2)))
    (Variables|Default|SetRouteDoneTime2 _now)
    (Variables|Default|SetScenarioStage 5))
  (if (and (== _s 5) (> _since 6.0))
    (CallFunction|EscrowHarnessWaypoint :Id 1 :X 5170.0 :Y 194300.0)
    (CallFunction|EscrowHarnessWaypoint :Id 4 :X 2170.0 :Y 194300.0)
    (CallFunction|EscrowHarnessWaypoint :Id 3 :X -830.0 :Y 194300.0)
    (CallFunction|EscrowHarnessWaypoint :Id 2 :X -3830.0 :Y 194300.0)
    (Variables|Default|SetScenarioStage 6))
  (if (and (== _s 6) (Utilities|String|Contains _phase "PhaseC"))
    (CallFunction|EscrowHarnessChain)
    (CallFunction|EscrowHarnessSetLeg :X -79330.0 :Y 326500.0)
    (Variables|Default|SetScenarioStage 7))
  (if (and (== _s 7) (and (Variables|Default|GetRouteDone) (Utilities|String|Contains _phase "PhaseE")))
    (Variables|Default|SetRouteDoneTime2 _now)
    (Variables|Default|SetScenarioStage 8))
  (if (and (== _s 8) (> _since 8.0))
    (CallFunction|EscrowHarnessWaypoint :Id 2 :X -82300.0 :Y 341074.0)
    (CallFunction|EscrowHarnessWaypoint :Id 3 :X -90860.0 :Y 335894.0)
    (Variables|Default|SetRouteDoneTime2 _now)
    (Variables|Default|SetScenarioStage 9))
  (if (and (== _s 9) (> _since 6.0))
    (bind _ok2 (CallFunction|EscrowHarnessAck :Sub "PLAN-VALIDATE"))
    (if _ok2
      (Variables|Default|SetRouteDoneTime2 _now)
      (Variables|Default|SetScenarioStage 10)))
  (if (and (== _s 10) (> _since 4.0))
    (bind _ok3 (CallFunction|EscrowHarnessAck :Sub "PLAN-AUTHORIZE"))
    (if _ok3
      (Variables|Default|SetRouteDoneTime2 _now)
      (Variables|Default|SetScenarioStage 11)))
  (if (and (== _s 11) (> _since 6.0))
    (bind _ok4 (CallFunction|EscrowHarnessAck :Sub "CLOSEOUT"))
    (if _ok4
      (Variables|Default|SetRouteDoneTime2 _now)
      (Variables|Default|SetScenarioStage 12)))
  (if (and (== _s 12) (> _since 8.0))
    (Variables|Default|SetScenarioStage 13)
    (Development|PrintString "HARNESS DONE" false)))
