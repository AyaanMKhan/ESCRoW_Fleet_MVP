(fn Escrow_NavPlan (Final)
  (bind _path (AI|Navigation|FindPathToLocationSynchronously (Transformation|GetActorLocation) Final self))
  (Variables|Default|SetPathPts (Class|NavigationPath|GetPathPoints _path))
  (Variables|Default|SetPathIdx 0)
  (Variables|Default|SetPathLastPlan (Utilities|Time|GetGameTimeInSeconds))
  (bind _len (Utilities|Array|Length (Variables|Default|GetPathPts)))
  (if (< _len 1)
    (Utilities|Array|Clear (Variables|Default|GetPathPts))
    (Utilities|Array|Add (Variables|Default|GetPathPts) Final)
    (elif (or (AI|Navigation|IsPartial _path) (> (Math|Vector|Distance2D(Vector) (Utilities|Array|Get(acopy) (Variables|Default|GetPathPts) (- _len 1)) Final) 300.0))
      (Utilities|Array|Clear (Variables|Default|GetPathPts))
      (Utilities|Array|Add (Variables|Default|GetPathPts) Final))))
