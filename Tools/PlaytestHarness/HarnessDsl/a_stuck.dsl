(fn Escrow_EscalateStuck ()
  (bind _now (Utilities|Time|GetGameTimeInSeconds))
  (bind _loc (Transformation|GetActorLocation))
  (bind _fwd (Transformation|GetActorForwardVector))
  (bind _right (Transformation|GetActorRightVector))
  (if (and (> (Variables|Default|GetStuckAttempts) 0) (or (> (- _now (Variables|Default|GetLastStuckTime)) 20.0) (> (Math|Vector|Distance(Vector) _loc (Variables|Default|GetStuckAnchorLoc)) 1500.0)))
    (Variables|Default|SetStuckAttempts 0))
  (Variables|Default|SetStuckAttempts (+ (Variables|Default|GetStuckAttempts) 1))
  (Variables|Default|SetLastStuckTime _now)
  (bind _attempt (Variables|Default|GetStuckAttempts))
  (if (== _attempt 1)
    (Variables|Default|SetStuckAnchorLoc _loc)
    (bind _hitrecent (and (> (Variables|Default|GetLastHitTime) 0.0) (< (- _now (Variables|Default|GetLastHitTime)) 8.0)))
    (bind _hitright (> (Math|Vector|DotProduct (- (Variables|Default|GetLastHitLoc) _loc) _right) 0.0))
    (bind _openright (>= (Variables|Default|GetLastSelSign) 0.0))
    (if _hitrecent
      (Variables|Default|SetRecoverySide (select _hitright -1.0 1.0))
      (else
        (Variables|Default|SetRecoverySide (select _openright 1.0 -1.0)))))
  (if (== _attempt 3)
    (Variables|Default|SetRecoverySide (* (Variables|Default|GetRecoverySide) -1.0)))
  (if (>= _attempt 4)
    (CallFunction|EscrowEscalateToOperator)
    (else
      (bind _side (Variables|Default|GetRecoverySide))
      (Variables|Default|SetRecoverySteer (select (== _attempt 1) 0.0 (* _side -0.6)))
      (Variables|Default|SetRecoveryReverseUntil (+ _now 6.0))
      (Variables|Default|SetRecoveryGoal (+ _loc (+ (* _right (* _side 600.0)) (* _fwd 600.0))))
      (Variables|Default|SetRecoveryGoalUntil (+ _now 12.0))
      (CallFunction|EscrowLogAutonomyEvent :EventType "RecoveryAttempt" :Detail (Utilities|String|Append "Attempt " (Utilities|String|ToString(Integer) _attempt))))))
