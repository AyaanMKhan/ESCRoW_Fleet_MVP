(fn Escrow_HarnessAck (Sub)
  (bind _fleet (ESCRoW|Subsystems|GetESCROWFleetSubsystem))
  (bind _n (ESCRoW|Fleet|GetMissionReportCount _fleet))
  (for _i (range _n)
    (bind (_r _ok) (ESCRoW|Fleet|GetMissionReportbyIndex :self _fleet :Index _i))
    (bind (_a _b _c _d _e _f _g _h) (Utilities|Struct|BreakESCROWMissionReport _r))
    (if (and (Utilities|String|Contains _a Sub) (not _h))
      (ESCRoW|Fleet|AcknowledgeMissionReport :self _fleet :Index _i)
      (Development|PrintString (Utilities|String|Append "HARNESS ack " _a) false)
      (return true)))
  (return false))
