(fn Escrow_HarnessTakeControl ()
  (bind _now (Utilities|Time|GetGameTimeInSeconds))
  (bind _cv (Utilities|Array|Get(acopy) (Actor|GetAllActorsOfClass "/Game/ESCROW/Blueprints/Vehicles/BP_ESCROW_CommandVehicle.BP_ESCROW_CommandVehicle_C")))
  (Variables|Default|SetCmdVehicle _cv)
  (Variables|Default|SetConvoyMgr (Utilities|Array|Get(acopy) (Actor|GetAllActorsOfClass "/Game/ESCROW/Blueprints/Scenario/BP_ESCROW_ConvoyTelemetryManager.BP_ESCROW_ConvoyTelemetryManager_C")))
  (Pawn|UnPossess (Game|GetPlayerController 0))
  (bind _vmc (Class|WheeledVehiclePawn|GetVehicleMovementComponent _cv))
  (Game|Components|ChaosVehicleMovement|SetRequiresControllerforInputs _vmc false)
  (Game|Components|ChaosVehicleMovement|SetUseAutomaticGears _vmc true)
  (for _f (Actor|GetAllActorsOfClass "/Game/ESCROW/Blueprints/Followers/BP_ESCROW_FollowerVehicle.BP_ESCROW_FollowerVehicle_C")
    (Class|BPESCROWFollowerVehicle|SetDriveDiagLog true _f))
  (Variables|Default|SetNextOrderTime (+ _now 2.0))
  (Variables|Default|SetControlTaken true)
  (Development|PrintString "HARNESS control taken" false))
