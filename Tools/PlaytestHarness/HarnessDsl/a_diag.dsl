(fn Escrow_LogDriveDiag ()
  (bind _now (Utilities|Time|GetGameTimeInSeconds))
  (if (and (Variables|Default|GetDriveDiagLog) (and (Variables|Default|GetOwnDriveActive) (> (- _now (Variables|Default|GetLastDiagTime)) 0.5)))
    (Variables|Default|SetLastDiagTime _now)
    (bind _loc (Transformation|GetActorLocation))
    (bind _rot (Transformation|GetActorRotation))
    (bind _speed (Math|Vector|DotProduct (Transformation|GetVelocity) (Transformation|GetActorForwardVector)))
    (bind _pursuit (CallFunction|EscrowPickPursuit))
    (Development|PrintString (Utilities|String|Append (Utilities|String|Append (Utilities|String|Append (Utilities|String|Append (Utilities|String|Append (Utilities|String|Append (Utilities|String|Append (Utilities|String|Append (Utilities|String|Append (Utilities|String|Append (Utilities|String|Append (Utilities|String|Append (Utilities|String|Append (Utilities|String|Append (Utilities|String|Append (Utilities|String|Append (Utilities|String|Append (Utilities|String|Append (Utilities|String|Append (Utilities|String|Append (Utilities|String|Append (Utilities|String|Append (Utilities|String|Append (Utilities|String|Append (Utilities|String|Append (Utilities|String|Append (Utilities|String|Append "DIAG F" (Utilities|String|ToString(Integer) (Variables|Default|GetFollowerID))) " t=") (Utilities|String|ToString(Float) _now)) " loc=") (Utilities|String|ToString(Vector) _loc)) " yaw=") (Utilities|String|ToString(Float) (.yaw _rot))) " final=") (Utilities|String|ToString(Vector) (Variables|Default|GetSwingFinalTarget))) " pursuit=") (Utilities|String|ToString(Vector) _pursuit)) " selAng=") (Utilities|String|ToString(Float) (Variables|Default|GetSelAng))) " selDist=") (Utilities|String|ToString(Float) (Variables|Default|GetSelDist))) " selCost=") (Utilities|String|ToString(Float) (Variables|Default|GetSelCost))) " speed=") (Utilities|String|ToString(Float) _speed)) " hold=") (Utilities|String|ToString(Boolean) (Variables|Default|GetFollowGapHold))) " rev=") (Utilities|String|ToString(Boolean) (Variables|Default|GetReversing))) " path=") (Utilities|String|ToString(Integer) (Utilities|Array|Length (Variables|Default|GetPathPts)))) " idx=") (Utilities|String|ToString(Integer) (Variables|Default|GetPathIdx))) false)))
